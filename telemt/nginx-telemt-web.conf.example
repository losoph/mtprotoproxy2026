# nginx vhost for telemt WEB mode — reference copy of what
# setup-telemt-web-node.sh writes to /etc/nginx/sites-available/telemt-web.conf.
#
# nginx terminates TLS and forwards the COMPLETE vhost to telemt's private
# plain-HTTP listener. Do not route only the carrier paths here: that would make
# authenticated and ordinary traffic observably different at the terminator and
# would bypass telemt's decoy policy. Keep the real site on another hostname.

map $http_upgrade $telemt_connection_upgrade {
    default upgrade;
    ''      '';
}

upstream telemt_web {
    server 127.0.0.1:18080;
    keepalive 64;          # idle pool, not a concurrency limit
}

server {
    listen 80;
    listen [::]:80;
    server_name proxy.example.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    # nginx < 1.25.1: use `listen 443 ssl http2;` instead of the `http2` directive.
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;                      # required by the https-lanes carrier
    server_name proxy.example.com;

    # Raw queries carry bridge capabilities and Authorization carries bearer
    # credentials — never write them to a log.
    access_log off;

    ssl_certificate     /etc/letsencrypt/live/proxy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proxy.example.com/privkey.pem;

    client_max_body_size 2m;       # >= web.limits.max_body_bytes (2 MiB default)

    location / {
        proxy_pass http://telemt_web;
        proxy_http_version 1.1;    # WebSocket Upgrade needs HTTP/1.1 upstream
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, don't append:
                                                         # telemt accepts exactly one IP
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $telemt_connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;    # > long_poll_secs (25) and 2x ws liveness
        proxy_read_timeout 65s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;   # the bridge replays byte-identical requests
                                   # itself; an established WebSocket never is
    }
}
